# Local development
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/uploads
PUBLIC_BASE_URL=http://localhost:3000

# Studio authentication (required — /studio and its API routes fail closed without these)
# Single-owner credential login; there is no user table yet.
# AUTH_OWNER_USERNAME: the only login username.
# AUTH_PASSWORD_HASH: generate with `npm run auth:hash-password -- "your-password"` (scrypt, never plaintext).
# AUTH_SESSION_SECRET: HMAC signing key for the session cookie, generate with `openssl rand -hex 32`.
AUTH_OWNER_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Future persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miles_ai

# Future AI providers — keep server-side only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock

# Future TTS provider
TTS_PROVIDER=mock
