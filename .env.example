# Local development
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/uploads
PUBLIC_BASE_URL=http://localhost:3000

# Studio authentication (required — /studio and its API routes fail closed without these)
# Single-owner passkey (WebAuthn) login; no username, no password, no user table.
#
# AUTH_SESSION_SECRET: HMAC signing key for the session cookie, generate with `openssl rand -hex 32`.
# AUTH_RP_ID: the exact domain the passkey is bound to (e.g. "xguo.ai", or "localhost" for dev).
#   WebAuthn credentials are bound to this domain for their lifetime — see README for the
#   Vercel-preview-URL-vs-final-custom-domain gotcha before registering.
# AUTH_ORIGIN: the full origin serving the site, matching AUTH_RP_ID (e.g. "https://xguo.ai",
#   or "http://localhost:3000" for dev).
AUTH_SESSION_SECRET=
AUTH_RP_ID=localhost
AUTH_ORIGIN=http://localhost:3000

# One-time passkey registration (see README "Registering the passkey").
# AUTH_SETUP_TOKEN: shared secret that gates /setup while no passkey is registered yet.
#   Remove this from your environment once registration succeeds — the server also
#   permanently refuses further registration once AUTH_PASSKEY_CREDENTIAL is set, so this
#   is defense in depth, not load-bearing.
# AUTH_PASSKEY_CREDENTIAL: set by pasting the JSON the /setup page shows you after you
#   register. Leave empty until then.
AUTH_SETUP_TOKEN=
AUTH_PASSKEY_CREDENTIAL=

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Future persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miles_ai

# Future AI providers — keep server-side only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock

# Future TTS provider
TTS_PROVIDER=mock
