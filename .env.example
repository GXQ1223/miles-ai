# Local development
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./data/uploads
PUBLIC_BASE_URL=http://localhost:3000

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Future persistence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miles_ai

# Future AI providers — keep server-side only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock

# Future TTS provider
TTS_PROVIDER=mock
